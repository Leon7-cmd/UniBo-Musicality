<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.unibo.musicality.controller.AuthController" stylesheets="@style.css">
    <center>
        <StackPane>
            <TabPane tabClosingPolicy="UNAVAILABLE" prefWidth="560" prefHeight="480">
                <tabs>
                    <Tab text="Login">
                        <AnchorPane>
                            <GridPane hgap="10" vgap="10" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="30"/>
                                    <ColumnConstraints percentWidth="70"/>
                                </columnConstraints>

                                <Label text="Email:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="tfLoginEmail" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <PasswordField fx:id="pfLoginPassword" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Button text="Accedi" onAction="#onLogin" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            </GridPane>
                        </AnchorPane>
                    </Tab>

                    <Tab text="Registrati">
                        <AnchorPane>
                            <GridPane hgap="10" vgap="10"
                                    AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20"
                                    AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="30"/>
                                    <ColumnConstraints percentWidth="70"/>
                                </columnConstraints>

                                <Label text="Nome Utente:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="tfRegUsername" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="tfRegEmail" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Nome:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <TextField fx:id="tfRegNome" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <Label text="Cognome:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                <TextField fx:id="tfRegCognome" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                <Label text="Password:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                <PasswordField fx:id="pfRegPassword" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                <Label text="Conferma Password:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                                <PasswordField fx:id="pfRegConfermaPassword" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                                <CheckBox fx:id="cbRegAutore" text="Autore" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                                <Button text="Registrati" onAction="#onRegister" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                            </GridPane>
                        </AnchorPane>
                    </Tab>
                </tabs>
            </TabPane>
        </StackPane>
    </center>
</BorderPane>

